# Database Configuration (Supabase PostgreSQL or Local Postgres)
# Local: postgresql://postgres:postgres@localhost:5432/creator_arc
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your_password@localhost:5432/creator_arc

# Broker Configuration
REDIS_URL=redis://localhost:6379/0

# Security Configuration
MASTER_PASSWORD=your_master_password_here

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here

# S3 Compatible Object Storage (Optional: Cloudflare R2 / Supabase Storage S3-API)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
